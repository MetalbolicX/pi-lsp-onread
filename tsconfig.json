{
	"compilerOptions": {
		"target": "ES2023",
		"lib": ["ES2023"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"types": ["node"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"verbatimModuleSyntax": true,
		"noEmitOnError": true,
		"skipLibCheck": true,
		"outDir": "dist",
		"rootDir": ".",
		"resolveJsonModule": true
	},
	"include": ["src", "tests"]
}
