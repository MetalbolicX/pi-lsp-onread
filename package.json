{
  "name": "pi-lsp-onread",
  "version": "0.0.1",
  "description": "Pi extension that activates project-configured LSP servers when the agent reads code and feeds diagnostics back to it. Configuration-first: it generates LSP config, never downloads language servers.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "lsp",
    "language-server-protocol",
    "diagnostics",
    "rescript"
  ],
  "license": "MIT",
  "author": "MetalbolicX",
  "bin": {
    "pi-lsp-onread": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./dist/extension.js"
    ]
  },
  "scripts": {
    "lint": "oxlint",
    "format": "biome format --write",
    "format:check": "biome format",
    "typecheck": "tsc --noEmit",
    "build": "rolldown -c",
    "test": "vitest run",
    "smoke:gopls": "GOPLS_SMOKE=1 vitest run tests/smoke",
    "smoke:rust-analyzer": "RUST_ANALYZER_SMOKE=1 vitest run tests/smoke",
    "smoke:pi-host": "pnpm build && PI_HOST_SMOKE=1 vitest run tests/smoke/pi-host.smoke.test.ts",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "vscode-languageserver-protocol": "^3.18.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@types/node": "^26.6.5",
    "oxlint": "^1.87.0",
    "rolldown": "^1.2.13",
    "typescript": "~7.0.2",
    "vitest": "^5.0.3"
  }
}
